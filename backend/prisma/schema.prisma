datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  uuid         String   @unique @default(uuid())
  email        String?
  inboundIds   String?
  dataLimitGb  Float    @default(0)
  usedDataBytes BigInt  @default(0)
  expireDate   DateTime?
  status       String   @default("ACTIVE")
  maxDevices   Int      @default(2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Node {
  id           String   @id @default(uuid())
  name         String
  type         String   @default("KHAREJ")
  ip           String
  apiPort      Int      @default(10085)
  status       String   @default("ONLINE")
  isMaster     Boolean  @default(false)
  tunnelType   String   @default("NONE")
  tunnelPort   Int?
  tunnelSecret String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inbound {
  id               String   @id @default(uuid())
  uuid             String   @unique @default(uuid())
  remark           String
  protocol         String   @default("vless")
  port             Int
  network          String   @default("tcp")
  security         String   @default("reality")
  sni              String?  @default("yahoo.com")
  privateKey       String?
  publicKey        String?
  shortId          String?
  enableFragment   Boolean  @default(true)
  fragmentLength   String   @default("100-200")
  fragmentInterval String   @default("10-20")
  customDomain     String?
  dataLimitGb      Float    @default(0)
  usedDataBytes    BigInt   @default(0)
  expireDate       DateTime?
  maxDevices       Int      @default(2)
  enabled          Boolean   @default(true)
  fingerprint      String?   @default("chrome") // uTLS Fingerprint (chrome, firefox, safari, ios, android, edge, random, randomized)
  certPath         String?   // Path to custom SSL Certificate
  keyPath          String?   // Path to custom SSL Private Key
  certIssuer       String?   // Let's Encrypt, Self-Signed, Custom
  certExpireDate   DateTime? // Certificate expiration date
  ssPassword       String?   // Shadowsocks: shared password for this inbound
  ssCipher         String?   @default("chacha20-ietf-poly1305") // Shadowsocks cipher method
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Certificate {
  id         String    @id @default(uuid())
  domain     String    @unique
  certPath   String
  keyPath    String
  issuer     String    @default("Let's Encrypt")
  expireDate DateTime?
  autoRenew  Boolean   @default(true)
  status     String    @default("VALID") // VALID, EXPIRING_SOON, EXPIRED, FAILED
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SystemSetting {
  key   String @id
  value String
}
